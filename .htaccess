# Return the custom 404 page for missing resources.
ErrorDocument 404 /404.html

# Enable Apache URL rewriting for canonical redirects.
<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS for all requests.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Redirect the www host to rehova.sg.
RewriteCond %{HTTP_HOST} ^www\.rehova\.sg$ [NC]
RewriteRule ^ https://rehova.sg%{REQUEST_URI} [R=301,L,NE]

# Redirect /index.html to the home page.
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Compress HTML, CSS, JavaScript, JSON, and SVG responses.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Set browser caching rules when mod_expires is available.
<IfModule mod_expires.c>
# Enable Expires headers.
ExpiresActive On
# Cache JPEG images for one year.
ExpiresByType image/jpeg "access plus 1 year"
# Cache PNG images for one year.
ExpiresByType image/png "access plus 1 year"
# Cache WebP images for one year.
ExpiresByType image/webp "access plus 1 year"
# Cache GIF images for one year.
ExpiresByType image/gif "access plus 1 year"
# Cache SVG images for one year.
ExpiresByType image/svg+xml "access plus 1 year"
# Cache icon images for one year.
ExpiresByType image/x-icon "access plus 1 year"
# Cache CSS files for one month.
ExpiresByType text/css "access plus 1 month"
# Cache JavaScript files for one month.
ExpiresByType text/javascript "access plus 1 month"
# Cache JavaScript files served with the application MIME type for one month.
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
